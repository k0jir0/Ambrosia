# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
DATABASE_URL=postgresql+psycopg://ambrosia:ambrosia@localhost:5432/ambrosia
REDIS_URL=redis://localhost:6379/0
AMBROSIA_ENV=development

# Optional model provider keys are intentionally not required for the deterministic MVP generator.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Selective integration rollout controls. Enable the workflow first, then turn
# enforcement on per controlled environment after migrations and invariant tests pass.
SELECTIVE_INTEGRATION_ENABLED=true
SELECTIVE_INTEGRATION_ENFORCED=false
