{
  "name": "ambrosia-trade-review",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "description": "Ambrosia Trade Review MVP monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm build:web",
    "start": "node index.js",
    "dev": "pnpm dev:web",
    "local:serve": "powershell -ExecutionPolicy Bypass -File scripts/local-stack.ps1 serve",
    "local:start": "powershell -ExecutionPolicy Bypass -File scripts/local-stack.ps1 start",
    "local:stop": "powershell -ExecutionPolicy Bypass -File scripts/local-stack.ps1 stop",
    "local:restart": "powershell -ExecutionPolicy Bypass -File scripts/local-stack.ps1 restart",
    "local:status": "powershell -ExecutionPolicy Bypass -File scripts/local-stack.ps1 status",
    "local:logs": "powershell -ExecutionPolicy Bypass -File scripts/local-stack.ps1 logs",
    "dev:web": "pnpm --filter @ambrosia/web dev",
    "dev:mobile": "pnpm --filter @ambrosia/mobile start",
    "mobile:android": "pnpm --filter @ambrosia/mobile android",
    "mobile:ios": "pnpm --filter @ambrosia/mobile ios",
    "mobile:web": "pnpm --filter @ambrosia/mobile web",
    "typecheck:mobile": "pnpm --filter @ambrosia/mobile typecheck",
    "test:mobile": "pnpm --filter @ambrosia/mobile test",
    "mobile:types:generate": "python scripts/generate-mobile-contract-types.py",
    "mobile:contract:write": "python scripts/verify-mobile-contracts.py --write",
    "mobile:contract:check": "python scripts/verify-mobile-contracts.py --check",
    "mobile:deployment:check": "python scripts/verify-mobile-deployment-readiness.py",
    "local:web:serve": "powershell -ExecutionPolicy Bypass -File scripts/local-web.ps1 serve",
    "local:web:start": "powershell -ExecutionPolicy Bypass -File scripts/local-web.ps1 start",
    "local:web:stop": "powershell -ExecutionPolicy Bypass -File scripts/local-web.ps1 stop",
    "local:web:restart": "powershell -ExecutionPolicy Bypass -File scripts/local-web.ps1 restart",
    "local:web:status": "powershell -ExecutionPolicy Bypass -File scripts/local-web.ps1 status",
    "local:web:logs": "powershell -Command \"Get-Content .local/ambrosia-web.log -Wait\"",
    "build:web": "pnpm --filter @ambrosia/web build",
    "lint:web": "pnpm --filter @ambrosia/web lint",
    "test:e2e": "pnpm --filter @ambrosia/web test:e2e",
    "local:api:serve": "powershell -ExecutionPolicy Bypass -File scripts/local-api.ps1 serve",
    "local:api:start": "powershell -ExecutionPolicy Bypass -File scripts/local-api.ps1 start",
    "local:api:stop": "powershell -ExecutionPolicy Bypass -File scripts/local-api.ps1 stop",
    "local:api:restart": "powershell -ExecutionPolicy Bypass -File scripts/local-api.ps1 restart",
    "local:api:status": "powershell -ExecutionPolicy Bypass -File scripts/local-api.ps1 status",
    "dev:api": "cd services/api && uv run uvicorn app.main:app --reload --port 8000",
    "test:api": "cd services/api && uv run --frozen pytest",
    "lint:api": "cd services/api && uv run --frozen ruff check app tests",
    "evals": "cd services/api && uv run python ../../packages/evals/run_evals.py",
    "evals:ablation": "cd services/api && uv run python ../../packages/evals/run_provider_ablation.py",
    "evals:retrieval": "cd services/api && uv run python ../../packages/evals/run_retrieval_benchmark.py",
    "evals:scanner": "cd services/api && uv run python ../../packages/evals/run_scanner_benchmark.py",
    "evals:financebench": "python packages/evals/run_financebench_relay.py",
    "evals:finqa": "python packages/evals/run_finqa_relay.py",
    "evals:tatqa": "python packages/evals/run_tatqa_relay.py",
    "evals:alpha-decay": "python packages/evals/run_alpha_decay_fixture.py",
    "evals:decision-memory": "python packages/evals/run_decision_memory_fixture.py",
    "evals:selective-integration": "python packages/evals/run_selective_integration.py",
    "frontend:quality:evidence": "python scripts/generate-frontend-quality-evidence.py",
    "routing-map:open-finllm": "python scripts/generate-open-finllm-routing-map.py",
    "enterprise:execution:check": "python scripts/verify-enterprise-execution.py",
    "index84:literal:check": "python scripts/verify-index84-literal.py",
    "index85:benchmarks:check": "python scripts/verify-index85-benchmarks.py",
    "schemas:index84:check": "python scripts/verify-index84-schemas.py",
    "web:control-plane:check": "python scripts/verify-web-control-plane.py",
    "release:evidence": "python scripts/generate-release-evidence.py",
    "release:readiness:check": "python scripts/verify-release-readiness.py",
    "production:evidence:check": "python scripts/verify-production-evidence.py",
    "docs:consistency:check": "python scripts/verify-docs-consistency.py",
    "index119:readiness:check": "python scripts/verify-index119-readiness.py",
    "index119:load:test": "python scripts/load-test-api.py",
    "selective:readiness:check": "python scripts/verify-selective-integration.py",
    "hotpath:design:check": "python scripts/verify-hotpath-design.py",
    "hotpath:phase7:check": "python scripts/verify-hotpath-phase7.py",
    "signals:index97:seed": "python scripts/seed-index97-signals.py",
    "signals:index97:check": "python scripts/seed-index97-signals.py --check-only",
    "index86:closure:check": "python scripts/verify-index86-closure.py",
    "roadmap:completion:check": "python scripts/verify-index84-completion.py",
    "db:migrations:check": "python scripts/verify-migrations.py",
    "scorecard:check": "cd services/api && uv run python ../../scripts/verify-scorecard-runtime.py",
    "m1:readiness": "uv run --project services/api --frozen python scripts/generate-m1-readiness.py",
    "synthetic:monitor": "python scripts/synthetic-monitor.py",
    "test:stack": "python -m unittest discover -s tests",
    "test:unit": "uv run --project services/api --frozen pytest tests/unit-tests -q",
    "test:deploy:e2e": "uv run --project services/api --frozen pytest tests/test_deploy_targets_e2e.py -q",
    "test:cli:e2e": "uv run --project services/api --frozen pytest tests/test_cli_design_e2e.py -q",
    "test:cli:live": "uv run --project services/api --frozen pytest tests/test_cli_live_function_matrix.py -q",
    "test:release": "uv run --project services/api --frozen pytest tests/unit-tests -q && cd services/api && uv run --frozen pytest -q",
    "cli:install": "cd packages/cli && uv sync",
    "cli:build": "powershell -ExecutionPolicy Bypass -File scripts/build-ambrosia-cli.ps1",
    "cli:build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-ambrosia-cli-exe.ps1",
    "cli:install:dist": "powershell -ExecutionPolicy Bypass -File scripts/install-ambrosia-cli.ps1 -Distribution -BuildDistribution",
    "cli:install:path": "powershell -ExecutionPolicy Bypass -File scripts/install-ambrosia-cli.ps1 -Distribution -BuildDistribution -AddToPath",
    "cli:menu": "cd packages/cli && uv run ambrosia commands list",
    "cli:status": "cd packages/cli && uv run ambrosia status",
    "cli:quickstart": "cd packages/cli && uv run ambrosia quickstart --target staging",
    "cli:examples": "cd packages/cli && uv run ambrosia examples",
    "cli:version": "cd packages/cli && uv run ambrosia --version",
    "smoke:test": "python scripts/deploy-smoke-test.py",
    "roadmap:routes": "cd services/api && uv run python ../../scripts/generate-index84-route-inventory.py --write",
    "roadmap:routes:check": "cd services/api && uv run python ../../scripts/generate-index84-route-inventory.py --check",
    "roadmap:openapi": "cd services/api && uv run python ../../scripts/generate-index84-route-inventory.py --write-openapi",
    "roadmap:openapi:check": "cd services/api && uv run python ../../scripts/generate-index84-route-inventory.py --check-openapi",
    "sdk:check": "python scripts/verify-sdk-cli.py",
    "visibility:sync": "python scripts/verify-visibility-matrix.py --write-artifacts",
    "visibility:check": "python scripts/verify-visibility-matrix.py"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.18",
      "sharp": "0.35.3",
      "uuid": "11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  }
}
