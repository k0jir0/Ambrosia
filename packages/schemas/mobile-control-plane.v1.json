{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ambrosia.local/schemas/mobile-control-plane.v1.json",
  "title": "Ambrosia Mobile Control Plane Contract",
  "type": "object",
  "required": ["schemaVersion", "governance", "routes"],
  "properties": {
    "schemaVersion": {
      "const": "mobile-control-plane.v1"
    },
    "governance": {
      "type": "object",
      "required": [
        "backendSystemOfRecord",
        "humanDecisionAuthority",
        "llmInLiveOrderLoop",
        "finalDecisionsRequireServerConfirmation"
      ],
      "properties": {
        "backendSystemOfRecord": { "type": "boolean" },
        "humanDecisionAuthority": { "type": "boolean" },
        "llmInLiveOrderLoop": { "type": "boolean" },
        "finalDecisionsRequireServerConfirmation": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "method",
          "path",
          "mobileModule",
          "clientFunction",
          "sourceOfTruth",
          "purpose",
          "mutating",
          "requiresServerConfirmation"
        ],
        "properties": {
          "method": {
            "enum": ["GET", "POST", "PATCH", "PUT", "DELETE"]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "mobileModule": {
            "type": "string",
            "minLength": 2
          },
          "clientFunction": {
            "type": "string",
            "minLength": 2
          },
          "sourceOfTruth": {
            "enum": ["fastapi"]
          },
          "purpose": {
            "type": "string",
            "minLength": 8
          },
          "mutating": {
            "type": "boolean"
          },
          "requiresServerConfirmation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
